# syntax=docker/dockerfile:1
# =====================================================================
# PETLINK - imagem combinada (backend Spring Boot + frontend SPA)
# Usada pelo Render (Web Service unico) e testes locais.
# Porta publica: 80 (nginx) | API interna: 8080 (Spring Boot)
# =====================================================================

# --- Estagio 1: build do backend (jar) ---------------------------------
FROM eclipse-temurin:21-jdk-jammy AS backend-build
WORKDIR /app

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY src ./src

RUN chmod +x ./mvnw
RUN ./mvnw -B -DskipTests \
    -Daether.connector.http.retryHandler.count=3 \
    -Daether.connector.http.retryHandler.requestTimeout=30000 \
    package

# --- Estagio 2: build do frontend (SPA) --------------------------------
FROM node:22-alpine AS frontend-build
WORKDIR /app

COPY petlink-frontend/package.json petlink-frontend/package-lock.json ./
COPY petlink-frontend/tsconfig*.json ./
COPY petlink-frontend/vite.config.ts ./
COPY petlink-frontend/index.html ./
COPY petlink-frontend/public ./public
COPY petlink-frontend/src ./src

RUN npm ci
RUN npm run build

# --- Estagio 3: runtime (JRE + nginx) ----------------------------------
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

EXPOSE 80
ENV SERVER_PORT=8090

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nginx gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY render/nginx.conf /etc/nginx/conf.d/default.conf
COPY render/entrypoint.sh /app/entrypoint.sh

COPY --from=backend-build /app/target/*.jar /app/app.jar
COPY --from=frontend-build /app/dist /usr/share/nginx/html

RUN chmod +x /app/entrypoint.sh

# Diretorio de uploads (efemero no free tier do Render)
RUN mkdir -p /app/uploads

ENTRYPOINT ["/app/entrypoint.sh"]