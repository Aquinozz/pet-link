# syntax=docker/dockerfile:1
# =====================================================================
# ZOOP - imagem combinada (backend Spring Boot + frontend Vinext SSR)
# Usada pelo Render (Web Service unico) e testes locais.
# Portas internas:
#   80   -> nginx (publica)
#   3000 -> Node/vinext (frontend SSR)
#   8090 -> Spring Boot (API)
# =====================================================================

# --- Estagio 1: build do backend (jar) ---------------------------------
FROM eclipse-temurin:21-jdk-jammy AS backend-build
WORKDIR /app

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY src ./src

RUN chmod +x ./mvnw
RUN ./mvnw -B -DskipTests \
    -Daether.connector.http.retryHandler.count=3 \
    -Daether.connector.http.retryHandler.requestTimeout=30000 \
    package

# --- Estagio 2: build do frontend (Vinext) ------------------------------
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc ./
COPY scripts ./scripts

RUN npm ci
COPY . .

RUN npm run build

# --- Estagio 3: runtime (JRE + Node + nginx) ----------------------------
# Base Ubuntu (temurin) garante o JRE 21; o Node e copiado do estagio 2
# (mesma licenca MIT, ja testada no build do frontend).
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

ENV SERVER_PORT=8090
ENV VINEXT_PORT=3000
EXPOSE 80 3000

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nginx gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /app/uploads

COPY --from=frontend-build /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend-build /usr/local/bin/npm /usr/local/bin/npm
COPY --from=frontend-build /usr/local/bin/npx /usr/local/bin/npx
COPY --from=frontend-build /usr/local/lib/node_modules /usr/local/lib/node_modules

COPY render/nginx.conf /etc/nginx/conf.d/default.conf
COPY render/entrypoint.sh /app/entrypoint.sh

COPY --from=backend-build /app/target/*.jar /app/app.jar
COPY --from=frontend-build /app/dist /app/dist
COPY --from=frontend-build /app/node_modules /app/node_modules
COPY --from=frontend-build /app/package.json /app/package.json

RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]